{
  "name": "lilac-srv",
  "version": "1.0.0",
  "description": "Typed, idempotent HTTP surface for Lilac Resolution persistence (ticket lifecycle, receipt issuance, claim/evidence linkage, timeline, parity diagnostics) \u2014 writes only canonical resolution.* tables",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "heartbeat-client": "file:../heartbeat-client",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11",
    "yaml": "^2.5.1"
  }
}
