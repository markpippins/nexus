{
  "name": "shrapnel-srv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the shrapnel Relational Object Store / EAV system backed by PostgreSQL.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate": "node src/scripts/migrate.js",
    "smoke": "node src/scripts/smoke.js",
    "dbcheck": "psql \"${SHRAPNEL_PG_DSN:-postgresql://pguser:pgpass@localhost:5432/postgres}\" -v ON_ERROR_STOP=1 -f negative_path_check.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "heartbeat-client": "file:../heartbeat-client",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.2"
  }
}
