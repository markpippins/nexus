[Unit]
Description=Cascade write-queue reconciler — drains nexus.write-queue.v1.> (local NATS) into canonical resolution schema
Documentation=https://github.com/nexus/python/cascade/write_queue_reconciler.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/python/cascade

# ── Environment ────────────────────────────────────────────────────────
# NATS bus is LOCAL on titanium; canonical PG is local too.
#
# NATS_URL MUST be explicit (do not rely on the script default) — but it must
# point at the broker that is actually authoritative:
#   2026-09-22 .. 2026-10-10 : nats://192.168.1.82:4222 (thallium, the
#                               nexus-core host) — this address is now
#                               UNREACHABLE from titanium.
#   2026-10-10 ->            : nats://localhost:4222 — operator confirmed
#                               local is authoritative.
# If the bus moves again, update THIS line and the date above together.
Environment=NATS_URL=nats://localhost:4222
Environment=DATABASE_URL=postgres://pguser:pgpass@localhost:5432/nexus
Environment=WRITE_QUEUE_CAPABILITY=nexus.storage.canonical
Environment=WRITE_QUEUE_DURABLE=write_queue_reconciler
Environment=WRITE_QUEUE_STREAM=WRITE_QUEUE

# ── Executable ─────────────────────────────────────────────────────────
# Paths below MUST point at the CANONICAL checkout (/home/codex/dev/nexus).
# NEVER pin this unit at a git worktree (AGENTS.md R8.0): worktrees are
# transient scratch, so a boot-time daemon pinned to one dies at
# status=200/CHDIR the moment it is pruned — it never reaches ExecStart, so
# it never subscribes, so the durable consumer is never created. That is
# exactly how WRITE_QUEUE ran 24 days with a stream and no consumer
# (incident 2026-10-10, escalation 4644f5f6, trace 13a81664).
# Start through the Option A deployment wrapper (f63bfbc7): it enforces
# provision → readiness → staging pre-existence gates, starts the
# fail-fast reconciler, and waits for durable-consumer attach before
# reporting success. Restart=on-failure then covers any post-attach
# crash; a prerequisite regression surfaces as loud gate failures.
ExecStart=/usr/bin/python3 /home/codex/dev/nexus/bin/start_write_queue_reconciler.py

# ── Restart behavior ───────────────────────────────────────────────────
# Persistent service, not a timer. Since PR #452 the reconciler is a
# JetStream DURABLE consumer (explicit acks): intents published while it
# is down are BACK-FILLED from the WRITE_QUEUE stream on restart. It
# still runs persistently so reconciliation is timely rather than batchy.
# SINGLE INSTANCE ONLY: the durable consumer has no queue group — a
# second instance would compete for the same deliveries.
Restart=on-failure
RestartSec=5

# ── Logging ────────────────────────────────────────────────────────────
SyslogIdentifier=write-queue-reconciler

[Install]
WantedBy=default.target
