[Unit]
Description=Cascade write-queue reconciler — drains nexus.write-queue.v1.> (thallium NATS) into canonical resolution schema
Documentation=https://github.com/nexus/python/cascade/write_queue_reconciler.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/python/cascade

# ── Environment ────────────────────────────────────────────────────────
# NATS bus lives on thallium (the nexus-core host); canonical PG is local.
# NATS_URL MUST be explicit — the script default (localhost:4222) is wrong
# on titanium since the bus moved to thallium (2026-09-22).
Environment=NATS_URL=nats://192.168.1.82:4222
Environment=DATABASE_URL=postgres://pguser:pgpass@localhost:5432/nexus
Environment=WRITE_QUEUE_CAPABILITY=nexus.storage.canonical
Environment=WRITE_QUEUE_DURABLE=write_queue_reconciler
Environment=WRITE_QUEUE_STREAM=WRITE_QUEUE

# ── Executable ─────────────────────────────────────────────────────────
# Start through the Option A deployment wrapper (f63bfbc7): it enforces
# provision → readiness → staging pre-existence gates, starts the
# fail-fast reconciler, and waits for durable-consumer attach before
# reporting success. Restart=on-failure then covers any post-attach
# crash; a prerequisite regression surfaces as loud gate failures.
ExecStart=/usr/bin/python3 /home/codex/dev/nexus/bin/start_write_queue_reconciler.py

# ── Restart behavior ───────────────────────────────────────────────────
# Persistent service, not a timer. Since PR #452 the reconciler is a
# JetStream DURABLE consumer (explicit acks): intents published while it
# is down are BACK-FILLED from the WRITE_QUEUE stream on restart. It
# still runs persistently so reconciliation is timely rather than batchy.
# SINGLE INSTANCE ONLY: the durable consumer has no queue group — a
# second instance would compete for the same deliveries.
Restart=on-failure
RestartSec=5

# ── Logging ────────────────────────────────────────────────────────────
SyslogIdentifier=write-queue-reconciler

[Install]
WantedBy=default.target
