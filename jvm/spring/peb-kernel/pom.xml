<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.nexus.peb</groupId>
    <artifactId>peb-kernel</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>peb-kernel</name>
    <description>Nexus Persistent Engineering Brain Kernel</description>

    <modules>
        <module>peb-domain</module>
        <module>peb-store</module>
        <module>peb-core</module>
        <module>peb-hash</module>
        <module>peb-api</module>
        <module>peb-adapters</module>
        <module>peb-observability</module>
        <module>peb-bootstrap</module>
        <module>peb-test</module>
    </modules>

    <properties>
        <java.version>21</java.version>

        <!-- Advisory pins (dependency triage, 2026-11-26). Boot 3.5.16 resolves
             tomcat 10.1.55, jackson 2.21.4, postgresql 42.7.11, log4j 2.24.3 and
             commons-lang3 3.17.0, each still short of its published fix. These
             properties pin the fixed versions above the BOM. -->
        <tomcat.version>10.1.62</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <postgresql.version>42.7.12</postgresql.version>
        <log4j2.version>2.25.5</log4j2.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Module Dependencies -->
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-hash</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.nexus.peb</groupId>
                <artifactId>peb-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
