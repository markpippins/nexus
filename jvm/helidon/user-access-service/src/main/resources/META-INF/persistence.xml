<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="userPU" transaction-type="JTA">
        <jta-data-source>user-access-ds</jta-data-source>
        <class>com.angrysurfer.helidon.nexus.user.model.UserRegistration</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="validate"/>
            <!-- validate only: schema is owned by migrations/the DBA tier. The
                 previous value (update) let JPA create/alter tables on boot
                 outside the migration ledger — removed per the single-write-path
                 schema governance rule. -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
