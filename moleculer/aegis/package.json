{
  "name": "moleculer-aegis",
  "version": "1.0.0",
  "description": "Moleculer port of typescript/aegis-srv (TLA+ state-machine registry over the aegis.* schema: registries, revisions, model-check, TLC runs, wind compilations, constants/variables/states/transitions/invariants CRUD)",
  "main": "dist/services/api.service.js",
  "scripts": {
    "dev": "moleculer-runner --hot --repl services/**/*.service.ts",
    "start": "moleculer-runner services/**/*.service.ts",
    "build": "tsc",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "moleculer": "^0.14.34",
    "moleculer-web": "^0.10.7",
    "nats": "^2.29.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
