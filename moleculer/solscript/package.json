{
  "name": "moleculer-solscript",
  "version": "1.0.0",
  "description": "Moleculer REST facade over the SOLScript TypeScript core (read-only: querying live, transitions 405 until JetStream write path lands)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "moleculer-runner --hot --repl services/**/*.service.ts",
    "start": "moleculer-runner dist/services",
    "build": "tsc",
    "cli": "moleculer connect NATS",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nexus/solscript": "file:../../typescript/solscript",
    "dotenv": "^16.4.0",
    "moleculer": "^0.14.34",
    "moleculer-web": "^0.10.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}