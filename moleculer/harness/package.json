{
  "name": "moleculer-harness",
  "version": "1.0.0",
  "description": "Moleculer port of typescript/harness-srv (generic agent execution harness: context resolution + opencode/ollama invocation, sync/async job contract)",
  "main": "dist/services/api.service.js",
  "scripts": {
    "dev": "moleculer-runner --hot --repl services/**/*.service.ts",
    "start": "moleculer-runner services/**/*.service.ts",
    "build": "tsc",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "moleculer": "^0.14.34",
    "moleculer-web": "^0.10.7",
    "nats": "^2.29.3",
    "pg": "^8.13.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^11.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
