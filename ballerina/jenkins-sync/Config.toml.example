# Copy to Config.toml and fill in. Config.toml is gitignored.
port = 9097
jenkinsBase = "http://192.168.1.209:8080"
# EITHER (legacy, takes precedence):
#jenkinsAuthBasic = "<base64('user:token')>"
# OR (preferred — matches ci-gateway keys):
jenkinsUser = "admin"
jenkinsToken = "<api-token>"
dbHost = "localhost"
dbPort = 5432
dbDatabase = "nexus"
dbUser = "pguser"
dbPass = "<password>"
syncIntervalSeconds = 120
