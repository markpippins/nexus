# ── Nexus Service Target Configuration ────────────────────────────────
# Copy this file to .env and customize values.
# WARNING: .env is gitignored. Do NOT commit credentials.
# After changing values, restart affected services.

# ── Service Endpoints (T25 blessed convention: <UNIT>_TARGET) ────────
# Pattern: <UNIT>_TARGET=http://localhost:<port>
#   <UNIT> = systemd unit name (minus ".service"), uppercased, "-" → "_".
#   e.g. wind-srv → WIND_SRV_TARGET, conduit-mcp → CONDUIT_MCP_TARGET,
#        file-system-server → FILE_SYSTEM_SERVER_TARGET.
# Vite/UI apps use: VITE_<UNIT>_TARGET=http://localhost:<port>

# Core backends
CONDUIT_MCP_TARGET=http://localhost:3100
NEBULA_SRV_TARGET=http://localhost:3101
# :3102 is the nebula-mcp-sse unit (the stdio nebula-mcp has no port)
NEBULA_MCP_SSE_TARGET=http://localhost:3102
ASSEMBLY_SRV_TARGET=http://localhost:3107
KNOWLEDGE_SRV_TARGET=http://localhost:3109
PEB_SRV_TARGET=http://localhost:3111
CASCADE_SRV_TARGET=http://localhost:3106
SEMANTICS_SRV_TARGET=http://localhost:3160
ROLE_MEMORY_SRV_TARGET=http://localhost:3500
HARNESS_SRV_TARGET=http://localhost:3420
FILE_SYSTEM_SERVER_TARGET=http://localhost:4042
SECURE_FILE_SYSTEM_SERVER_TARGET=http://localhost:4040
SERVICE_REGISTRY_TARGET=http://localhost:8085
OPERATOR_SVC_TARGET=http://localhost:3018
WIND_SRV_TARGET=http://localhost:3300
TACKLE_SRV_TARGET=http://localhost:3410

# ── Google Search API ────────────────────────────────────────────────
# Shared by: moleculer-search (Node) and broker-gateway (Spring Boot)
# WARNING: Do NOT commit credentials.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id

# ── MongoDB ──────────────────────────────────────────────────────────
# Overrides spring.data.mongodb.uri for broker-gateway
# Credentials from atomic-mongodb Docker container
# authSource=admin is REQUIRED: the root user lives in the admin DB.
SPRING_DATA_MONGODB_URI=mongodb://mongoUser:YOUR_MONGO_PASSWORD@localhost:27017/nexus?authSource=admin

# Agent-discoverable alias for the same connection string (to-do d6db2b90,
# consolidated with 7b0d775d item 2). Consumers and tooling should read
# MONGO_URI first and fall back to SPRING_DATA_MONGODB_URI; `bin/mongo-sh`
# already does, so agents never need to parse or guess the Spring key.
# Same value as SPRING_DATA_MONGODB_URI above — one credential, two names.
# Contains credentials: keep this file gitignored, never commit a real value.
MONGO_URI=mongodb://mongoUser:YOUR_MONGO_PASSWORD@localhost:27017/nexus?authSource=admin

# Root credentials for the atomic-mongodb container, single-sourced here so
# bin/start-mongodb-docker.sh and bin/mongodb-health-monitor.sh read the same
# values instead of hardcoding literals (To Do 7b0d775d, docs/t25/0.1).
# Rotating these requires a FRESH mongodb_data volume (or an in-DB user
# update) — the init credentials only apply at first initialization.
MONGO_ROOT_USER=mongoUser
MONGO_ROOT_PASS=YOUR_MONGO_PASSWORD

# Discoverable connection string for non-Spring consumers (moleculer broker,
# cand-broker, fs-crawler). Contains credentials — keep .env gitignored.
MONGO_URL=mongodb://mongoUser:YOUR_MONGO_PASSWORD@localhost:27017/nexus?authSource=admin

# Publish addresses for the mongod port (bin/start-mongodb-docker.sh).
# ONE OR MORE addresses, separated by spaces or commas; each becomes its own
# `-p addr:27017:27017`. The consumers are split, which is why one address is
# not enough:
#   host java (broker-gateway)      -> 127.0.0.1 (measured loopback sockets)
#   containers (cand-broker, stack) -> the docker bridge gateway, because
#                                      host.docker.internal is NOT loopback
# So 127.0.0.1 alone breaks containers and 172.17.0.1 alone breaks the host.
# Recommended (drops LAN exposure, keeps both):
MONGO_BIND_ADDR=127.0.0.1 172.17.0.1
# The historical default, kept for an unmodified deployment, is:
# MONGO_BIND_ADDR=0.0.0.0

# ── PostgreSQL ───────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=pguser
PGPASSWORD=YOUR_PG_PASSWORD
PGDATABASE=nexus
