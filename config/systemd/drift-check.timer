[Unit]
Description=daily fleet drift census schedule (13:45Z, after lease-probe 13:05 and calendar consolidate 13:35)
# Persistent=true: a missed schedule (machine asleep) runs once on wake.
[Timer]
OnCalendar=*-*-* 13:45:00 UTC
Persistent=true
Unit=drift-check.service

[Install]
WantedBy=timers.target
