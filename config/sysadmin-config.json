  "healthCheckTemplates": {
    "port": {
      "description": "Check if TCP port is open",
      "timeout": 3,
      "method": "bash -c 'echo > /dev/tcp/{host}/{port}'"
    },
    "http": {
      "description": "HTTP GET with expected status code",
      "timeout": 5,
      "method": "curl -s --max-time {timeout} -o /dev/null -w '%{http_code}' http://{host}:{port}{endpoint}"
    },
    "command": {
      "description": "Run a shell command and check output for expected string",
      "timeout": 5,
      "method": "{command}"
    }
  }
}
