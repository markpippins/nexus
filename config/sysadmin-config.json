    "ticketsFile": "${XDG_RUNTIME_DIR:-/run/user/1000}/nexus-sysadmin/tickets.json",
    "maintenanceFile": "${XDG_RUNTIME_DIR:-/run/user/1000}/nexus-sysadmin/maintenance.md",
