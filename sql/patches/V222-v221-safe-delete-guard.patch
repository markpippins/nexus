-    SELECT jsonb_agg(w.id::text ORDER BY w.id) INTO v_ids
-      FROM resolution.work_request w
-     WHERE w.source_requirement_id = p_id;
+    -- A work request names its requirement through the normalized link table.
+    -- V221 drops `resolution.work_request.source_requirement_id`, so a static
+    -- read of that column raises 42703 on the first delete after V221. `to_jsonb`
+    -- keeps the legacy shortcut visible while it still exists (V222 may be
+    -- applied before V221), and the link table keeps the reference visible once
+    -- it is gone. The to_jsonb leg can be deleted when V221 is universal.
+    SELECT jsonb_agg(s.id ORDER BY s.id) INTO v_ids
+      FROM (
+          SELECT DISTINCT w.id::text AS id
+            FROM resolution.work_request w
+           WHERE (to_jsonb(w) ->> 'source_requirement_id')::uuid = p_id
+              OR EXISTS (SELECT 1
+                           FROM resolution.request_requirement_link l
+                          WHERE l.request_id = w.id
+                            AND l.requirement_id = p_id
+                            AND l.relation = 'source')
+      ) AS s;
     IF v_ids IS NOT NULL THEN
         v_blockers := v_blockers || jsonb_build_object('work_requests', v_ids);
     END IF;
