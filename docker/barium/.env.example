# docker/barium — environment configuration for barium standby tier.
# Copy to .env and fill in values. All secrets MUST come from environment or secret manager.

# PostgreSQL (remote on vanadium or local if enabled)
NEXUS_PG_DSN=postgresql://pguser:pgpass@vanadium:5432/nexus

# NATS for calendar emitter heartbeat
HEARTBEAT_REGISTRY_URL=

# PostgreSQL credentials (if using local postgres)
# PG_PASS=changeme

# Redis (if enabled)
# REDIS_HOST=redis
# REDIS_PORT=6379