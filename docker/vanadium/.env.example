# Vanadium tier environment — copy to .env and edit.
# Same file serves local smoke tests (offset *_HOST_PORT) and vanadium
# deployment (native ports). PG/Redis endpoints point at the tier's DB
# per the middle-path topology (vanadium local PG once the DB plan lands;
# host bridge 172.17.0.1 when co-located with titanium during testing).

PG_HOST=172.17.0.1
PG_PORT=5432
PG_USER=pguser
PG_PASS=changeme
PG_DB_NAME=nexus

NEXUS_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
PEB_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
TACKLE_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
CONDUIT_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
MEMORY_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
PROMPT_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
SEMANTICS_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus

MEMORY_REDIS_URL=redis://172.17.0.1:6379
PROMPT_REDIS_URL=redis://172.17.0.1:6379
REGISTRY_REDIS_HOST=redis

# Tier heartbeats → this host's service-registry container (set to your LAN IP)
HEARTBEAT_REGISTRY_URL=http://192.168.1.209:8085
# Dedicated registry database on the DB server — never the shared nexus DB
REGISTRY_DB_NAME=vanadium_registry

NEBULA_URL=http://172.17.0.1:3101
CONDUIT_MCP_URL=http://172.17.0.1:3100
REDIS_HOST=172.17.0.1

# Host port mappings — offset +10000 locally when coexisting with live services
WIND_HOST_PORT=3300
TACKLE_HOST_PORT=3410
KERNEL_HOST_PORT=8100
PEB_HOST_PORT=3111
CASCADE_HOST_PORT=3106
HARNESS_HOST_PORT=3420
EXECUTION_HOST_PORT=3110
PROMPT_HOST_PORT=3501
MEMORY_HOST_PORT=3500
ASSEMBLY_HOST_PORT=3107
CONDUIT_HOST_PORT=3104
KNOWLEDGE_HOST_PORT=3109
NEBULA_HOST_PORT=3101
SEMANTICS_HOST_PORT=3160
TERRAIN_TS_HOST_PORT=8086
VOYAGER_HOST_PORT=3114
REGISTRY_HOST_PORT=8085

HARNESS_WORK_DIR=./work
OPENCODE_BIN=opencode
OLLAMA_URL=http://172.17.0.1:11434
