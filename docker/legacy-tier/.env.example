# Legacy tier environment — copy to .env and edit before `docker compose up -d --build`.
# The tier reuses existing PostgreSQL schemas (wind, tackle, conduit, peb,
# cascade, kernel, execution, memory) — it does NOT create or migrate them.
#
# On a remote machine, point these at that machine's own PG/Redis.
# When running the tier on the SAME machine as live services (smoke test),
# remap every *_SRV_PORT to free high ports and address PG/Redis via the
# docker bridge gateway (default 172.17.0.1).

# ── PostgreSQL / Redis endpoints ─────────────────────────────────────
PG_HOST=172.17.0.1
PG_PORT=5432
PG_USER=pguser
PG_PASS=changeme
PG_DB_NAME=nexus

NEXUS_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
PEB_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
TACKLE_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
CONDUIT_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
MEMORY_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus
PROMPT_PG_DSN=postgres://pguser:changeme@172.17.0.1:5432/nexus

MEMORY_REDIS_URL=redis://172.17.0.1:6379
PROMPT_REDIS_URL=redis://172.17.0.1:6379

# ── Cross-service endpoints (defaults assume in-network names that do
#    NOT exist in this compose file — set explicitly) ─────────────────
NEBULA_URL=http://172.17.0.1:3101
CONDUIT_MCP_URL=http://172.17.0.1:3100

# ── Host port mappings (offset +10000 when coexisting with live services)
WIND_HOST_PORT=3300
TACKLE_HOST_PORT=3410
KERNEL_HOST_PORT=8100
PEB_HOST_PORT=3111
CASCADE_HOST_PORT=3106
HARNESS_HOST_PORT=3420
EXECUTION_HOST_PORT=3110
PROMPT_HOST_PORT=3501
MEMORY_HOST_PORT=3500

# ── harness-srv specifics ────────────────────────────────────────────
# Volume-mounted workdir inside the container (/nexus) and the opencode
# binary must exist for full function; health checks pass without them.
PG_PASSWORD=changeme
HARNESS_WORK_DIR=./work
OPENCODE_BIN=opencode
OLLAMA_URL=http://172.17.0.1:11434

# Redis for harness-srv session state (host bridge when co-located)
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
