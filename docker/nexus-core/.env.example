# Copy to .env next to this file and fill in real values.
#   cp .env.example .env   (never commit .env)

# PostgreSQL credentials for the target database (vanadium backup replica).
PG_USER=pguser
PG_PASS=changeme

# Full JDBC URL. Default targets the vanadium replica; override to retarget
# (e.g. helium-local PG, or titanium primary 192.168.1.120).
NEXUS_CORE_DB_URL=jdbc:postgresql://vanadium:5432/nexus

# Host port for the monolith (container listens on SERVER_PORT, default 8092;
# 8090 is atlas, 8091 was the quarkus broker gateway — both taken).
NEXUS_CORE_HOST_PORT=8092
NEXUS_CORE_PORT=8092

# Optional: NATS for the mobile write-queue. Lazy-connecting; when
# unreachable, write intents buffer locally instead of failing requests.
NATS_URL=nats://vanadium:4222
