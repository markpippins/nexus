# Source of truth for ~/.config/systemd/user/deploy-pin-drift-alarm.service
#
# Deploy (operator action, same doctrine as landed-digest-guard.service):
#   cp bin/deploy-pin-drift-alarm.service         ~/.config/systemd/user/
#   cp bin/deploy-pin-drift-alarm.timer           ~/.config/systemd/user/
#   cp bin/deploy-pin-drift-alarm-watchdog.service ~/.config/systemd/user/
#   cp bin/deploy-pin-drift-alarm-watchdog.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now deploy-pin-drift-alarm.timer
#   systemctl --user enable --now deploy-pin-drift-alarm-watchdog.timer
#   bin/deploy-pin-drift-alarm.py --accept    # establish the baseline once
#
# Why: conduit-kernel.service and nexus-execution-worker.service both import
# out of /home/codex/deploy/lilac-shadow (pin base 318d9ea8 + deploy-lineage
# commit 39898886, branch deploy/lilac-pin-318d9ea8-receipt-issued). Nothing
# under bin/, docs/ or .github/ pulls or resets that tree, so drift is always
# an operator action — this alarm turns that silence into a forum post on
# issues-and-open-questions.
#
# Liveness: an alarm that stopped running looks identical to a clean tree, so
# every completed check writes ~/.cache/deploy-pin-drift-alarm/heartbeat.json
# and the WATCHDOG timer (offset to *:7/15, `--watchdog`) posts when that
# heartbeat ages past 45 min — three missed runs. Install both: the check
# without the watchdog can go silent.
#
# Read-only over the deploy tree; runs from the PRIMARY checkout. Baseline and
# episode dedupe live in ~/.cache/deploy-pin-drift-alarm/state.json. Exit 2
# (drift) fails the unit on purpose so the journal shows it too.
#
# `--post` is the delivery channel and it is not a default (2026-11-28): without
# it the script reports DRIFT/STALLED to stdout and the exit code only. Keep it
# on ExecStart — removing it makes this alarm silent while still failing red.
#
# `--scheduled` is the other half of the same idea: the heartbeat this unit
# writes is the WATCHDOG's evidence that the timer is firing. A manual run must
# not refresh it (that flips a stalled alarm back to OK for up to 45 min), so
# only this scheduled ExecStart carries the flag. Keep both flags together.
[Unit]
Description=deploy pin drift alarm (HEAD + tracked python/ digests of /home/codex/deploy/lilac-shadow)
Documentation=file:///home/codex/dev/nexus/bin/deploy-pin-drift-alarm.py
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/codex/dev/nexus/bin/deploy-pin-drift-alarm.py --post --scheduled
TimeoutStartSec=180
