# Source of truth for ~/.config/systemd/user/landed-digest-guard.service
#
# Deploy (operator action, per attestation-janitor.service doctrine):
#   cp bin/landed-digest-guard.service ~/.config/systemd/user/
#   cp bin/landed-digest-guard.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now landed-digest-guard.timer
#
# Why: the pin registry (bin/landed-tool-pins.json) pins the blob digests of
# every critical tool (supersede-record.sh, attestation_janitor.py,
# merge_pr.py, gate_codes.py) so each squash merge can be proven byte-faithful.
# No CI job checks the POST-squash state; this guard closes that window
# automatically, hourly, for all pins at once.
#
# Runs in the PRIMARY checkout /home/codex/dev/nexus. The fetch in
# ExecStartPre only advances the local origin/main ref — the guard itself is
# read-only (git cat-file / git show), writes nothing, touches no records,
# no APIs, no forums.
#
# Failure model (exit-code oracle of bin/landed_digest_guard.py; aggregate =
# highest-priority verdict over all pins):
#   exit 0 ALL_MATCH     — every landed digest equals its pin; unit succeeds
#   exit 1 TOOL_ERROR    — git/registry failure; unit failed = guard broken
#   exit 2 MISSING       — a pinned tool is absent from origin/main and
#                          nothing queued it — registry/landing mismatch
#   exit 3 PARITY_DRIFT  — ALERT: a landed digest differs from its pin (or a
#                          queued head was force-pushed); investigate the
#                          squash merge before trusting the affected tool
#   exit 4 QUEUED_PENDING— informational: tools queued on open PRs and/or
#                          landed at a queued digest awaiting pin advance.
#                          The unit fails by design so the pending state
#                          stays visible until every pin matches.
#
# Journal signatures:
#   journalctl --user -u landed-digest-guard.service -n 30
#   drift:   "[DRIFT ] <path>: landed sha256=... != pin ..."
#   waiting: "[QUEUED] <path>: absent from origin/main ... but expected digest queued"

[Unit]
Description=landed-tool parity pin guard — registry of post-squash blob digests (read-only, hourly)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/codex/dev/nexus
ExecStartPre=/usr/bin/git -C /home/codex/dev/nexus fetch --quiet origin main
ExecStart=/usr/bin/python3 /home/codex/dev/nexus/bin/landed_digest_guard.py --repo /home/codex/dev/nexus --rev origin/main
TimeoutStartSec=300
SyslogIdentifier=landed-digest-guard

[Install]
WantedBy=default.target
