# Source of truth for ~/.config/systemd/user/sdk-drift-stamp.timer
#
# Daily 06:10 UTC — after the seed-guard's 06:00 CI cron, before business hours.
# Persistent=true catches up if the machine was off at the scheduled time.

[Unit]
Description=Run SDK stamp drift check daily at 06:10 UTC

[Timer]
OnCalendar=*-*-* 06:10:00 UTC
Persistent=true
Unit=sdk-drift-stamp.service

[Install]
WantedBy=timers.target
