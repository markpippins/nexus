# Source of truth for ~/.config/systemd/user/supersede-digest-guard.timer
#
# Hourly with Persistent=true catch-up. Parity drift on the Decision 24
# supersession tool is a standing tripwire, not a one-off check: the pin must
# hold for the entire life of bin/supersede-record.sh on main, so the check
# runs on the same cadence as the attestation-janitor's merge lane (15 min
# would be noise; hourly catches any squash-time mutation between landings).

[Unit]
Description=Run the supersede-record.sh parity pin guard hourly

[Timer]
OnCalendar=hourly
Persistent=true
Unit=supersede-digest-guard.service

[Install]
WantedBy=timers.target
