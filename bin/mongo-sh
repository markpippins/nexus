#!/usr/bin/env bash
# bin/mongo-sh — agent-discoverable mongo shell into atomic-mongodb
# ==================================================================
#
# Sweep-tooling 5/6 residual (planner to-do d6db2b90, consolidated with
# integration to-do 7b0d775d): give agents a deterministic exec path into
# the MongoDB container without hardcoding credentials in command history.
#
# REOPENED 2026-11-11: the original acceptance was "mongosh available to
# agents"; it was closed on a wrapper around the *legacy* `mongo` shell, which
# the 4.4 -> 8.0 upgrade path removes at 6.0 (to-do b3909d09, G0 evidence
# record 9b33a740). mongosh is now preferred, installed on the host, and the
# legacy shell is only a fallback.
#
# Credentials come from MONGO_URI (the agent-discoverable alias) or, for
# backward compatibility, SPRING_DATA_MONGODB_URI in nexus/.env (single source
# of record — see architect record ea9167c6). MONGO_URI wins when both exist.
# Credentials are never echoed here.
#
# Client resolution (first available wins)
# ---------------------------------------
#   1. $MONGO_SHELL_BIN          explicit override (host binary, else container)
#   2. host   mongosh            preferred — takes the URI directly
#   3. host   mongo              legacy shell
#   4. container mongosh         via docker exec
#   5. container mongo           via docker exec (4.4-era images only)
#
# Usage
# -----
#     bin/mongo-sh                          # interactive shell against nexus db
#     bin/mongo-sh --eval 'db.stats()'      # one-off command (passed through)
#     MONGO_SHELL_BIN=mongo bin/mongo-sh    # force the legacy shell
#
# Environment
# -----------
#     MONGO_CONTAINER   container name        (default atomic-mongodb)
#     MONGO_SHELL_BIN   force a client        (mongosh | mongo | absolute path)
#     MONGO_ENV_FILE    path to the env file  (default <nexus>/.env)
#     MONGO_URI         connection URI override / discoverable env key
#
# Exit codes
# ----------
#   0/1/2 — exit code of the underlying shell, passed through
#   3     — configuration error (.env missing or URI unparseable)
#   4     — no MongoDB client available in any location

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NEXUS_ROOT="$(cd "$BIN_DIR/.." && pwd)"
ENV_FILE="${MONGO_ENV_FILE:-$NEXUS_ROOT/.env}"
CONTAINER="${MONGO_CONTAINER:-atomic-mongodb}"

# Prefer an explicit process override, then the new env-file alias, then the
# existing Spring key. The URI value stays in memory/argv only; never log it.
URI="${MONGO_URI:-}"
if [ -z "$URI" ] && [ -f "$ENV_FILE" ]; then
    URI="$(grep -E '^MONGO_URI=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)"
fi
if [ -z "$URI" ] && [ -f "$ENV_FILE" ]; then
    URI="$(grep -E '^SPRING_DATA_MONGODB_URI=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)"
fi
[ -n "$URI" ] || {
    if [ ! -f "$ENV_FILE" ] && [ -z "${MONGO_URI:-}" ]; then
        echo "mongo-sh: $ENV_FILE not found (set MONGO_URI or provide the env file)" >&2
    else
        echo "mongo-sh: MONGO_URI or SPRING_DATA_MONGODB_URI not set in $ENV_FILE" >&2
    fi
    exit 3
}

case "$URI" in
    mongodb://*|mongodb+srv://*) ;;
    *) echo "mongo-sh: MONGO_URI is not a mongodb:// URI" >&2; exit 3 ;;
esac

# Credentials are only needed by the legacy shell; mongosh takes the URI as-is
# (which also keeps percent-encoding intact). Parse the *encoded* URI and decode
# the user and password separately: decoding first would let a percent-encoded
# '@' or ':' inside the password be mistaken for a delimiter and silently
# truncate it.
decode() { printf '%b' "${1//%/\\x}"; }

authority="${URI#*://}"
authority="${authority%%/*}"
if [[ "$authority" == *@* ]]; then userinfo="${authority%@*}"; else userinfo=""; fi
user_enc="${userinfo%%:*}"
if [[ "$userinfo" == *:* ]]; then pass_enc="${userinfo#*:}"; else pass_enc=""; fi
user="$(decode "$user_enc")"
pass="$(decode "$pass_enc")"

rest="${URI#*://}"
if [[ "$rest" == */* ]]; then
    path_part="${rest#*/}"
    db="${path_part%%[?#]*}"
else
    db=""
fi

legacy_ready() { [ -n "$user" ] && [ -n "$pass" ] && [ -n "$db" ]; }

have_host() { command -v "$1" >/dev/null 2>&1; }

have_in_container() {
    docker exec "$CONTAINER" sh -c "command -v '$1' >/dev/null 2>&1" >/dev/null 2>&1
}

run_host_mongosh() { exec mongosh "$URI" "$@"; }
run_container_mongosh() { exec docker exec -i "$CONTAINER" mongosh "$URI" "$@"; }

run_host_mongo() {
    legacy_ready || { echo "mongo-sh: could not parse user/pass/db from URI for the legacy shell" >&2; exit 3; }
    exec mongo -u "$user" -p "$pass" --authenticationDatabase admin "$db" "$@"
}

run_container_mongo() {
    legacy_ready || { echo "mongo-sh: could not parse user/pass/db from URI for the legacy shell" >&2; exit 3; }
    exec docker exec -i "$CONTAINER" mongo -u "$user" -p "$pass" --authenticationDatabase admin "$db" "$@"
}

# 1. Explicit override
if [ -n "${MONGO_SHELL_BIN:-}" ]; then
    case "$MONGO_SHELL_BIN" in
        mongosh)
            if have_host mongosh;   then run_host_mongosh "$@"; fi
            if have_in_container mongosh; then run_container_mongosh "$@"; fi
            ;;
        mongo)
            if have_host mongo;     then run_host_mongo "$@"; fi
            if have_in_container mongo;   then run_container_mongo "$@"; fi
            ;;
        *)
            if have_host "$MONGO_SHELL_BIN"; then exec "$MONGO_SHELL_BIN" "$URI" "$@"; fi
            if have_in_container "$MONGO_SHELL_BIN"; then
                exec docker exec -i "$CONTAINER" "$MONGO_SHELL_BIN" "$URI" "$@"
            fi
            ;;
    esac
    echo "mongo-sh: MONGO_SHELL_BIN=$MONGO_SHELL_BIN not found on the host or in container '$CONTAINER'" >&2
    exit 4
fi

# 2-5. Auto-detect, preferring mongosh everywhere.
if have_host mongosh;          then run_host_mongosh "$@"; fi
if have_host mongo;            then run_host_mongo "$@"; fi
if have_in_container mongosh;  then run_container_mongosh "$@"; fi
if have_in_container mongo;    then run_container_mongo "$@"; fi

cat >&2 <<EOF
mongo-sh: no MongoDB client available.

  tried: host 'mongosh', host 'mongo', 'mongosh' in container '$CONTAINER',
         'mongo' in container '$CONTAINER'

  Install mongosh on the host (no root required):

    mkdir -p ~/.local/opt ~/.local/bin
    curl -fsSL https://downloads.mongodb.com/compass/mongosh-<ver>-linux-x64.tgz \\
      | tar -xz -C ~/.local/opt
    ln -sfn ~/.local/opt/mongosh-<ver>-linux-x64/bin/mongosh ~/.local/bin/mongosh

  Then re-run this command. To force a specific client:
    MONGO_SHELL_BIN=mongosh bin/mongo-sh
EOF
exit 4
